{
  "name": "hounddog",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest --globals",
    "test:core": "vitest --dir packages/core --globals",
    "build": "pnpm -r --if-present build",
    "build:core": "pnpm --filter @hounddog/core build",
    "build:fetch": "pnpm --filter @hounddog/fetch build",
    "build:express": "pnpm --filter @hounddog/express build",
    "build:cli": "pnpm --filter @hounddog/cli build",
    "install:all": "pnpm install --filter . --include=dev",
    "clean:all": "pnpm -r --if-present clean",
    "cli:tail": "pnpm --filter @hounddog/cli build && node packages/cli/dist/cli.js tail --path examples/api/.hounddog/events.jsonl --from-start",
    "cli:last": "pnpm --filter @hounddog/cli build && node packages/cli/dist/cli.js flows last --path examples/api/.hounddog/events.jsonl",
    "example:api": "pnpm --filter hounddog-example-api dev",
    "example:web": "pnpm --filter hounddog-example-web dev"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "packageManager": "pnpm@10.18.0+sha512.e804f889f1cecc40d572db084eec3e4881739f8dec69c0ff10d2d1beff9a4e309383ba27b5b750059d7f4c149535b6cd0d2cb1ed3aeb739239a4284a68f40cfa",
  "dependencies": {
    "dev": "^0.1.3"
  }
}
